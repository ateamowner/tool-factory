{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tool-factory-alpha.vercel.app"
        }
      ],
      "destination": "https://ateamkit.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<host>.+)\\.vercel\\.app"
        }
      ],
      "destination": "https://ateamkit.com/:path*",
      "statusCode": 301
    }
  ]
}
